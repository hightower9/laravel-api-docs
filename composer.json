{
    "name": "hightower9/laravel-api-docs",
    "description": "Generates a static API docs site from Laravel routes and FormRequests.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/process": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0",
        "symfony/finder": "^7.1|^8.0",
        "symfony/yaml": "^7.1|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Souqbox\\ApiDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Souqbox\\ApiDocs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Souqbox\\ApiDocs\\ApiDocsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
